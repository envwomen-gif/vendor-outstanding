# Postgres connection string (Neon pooled URL on Vercel)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Google service account JSON, on ONE line. The app only reads the sheets.
GOOGLE_SERVICE_ACCOUNT_JSON=
OUTSTANDING_SHEET_ID=1fZiQsRlfiw4pmoHAIX9DfNfJlOz233lerHGRA7rL5s8
BENE_SHEET_ID=1bgh6wkOcy54OBEjQbvVZI3T0G-OUUKHoUzds0or9kKs
# Optional. These are the defaults. The first one ends with a space.
# OUTSTANDING_TAB="OUTSTANDINGS "
# BENE_TAB="ALL DETAILS"

# Sign in is OFF while APP_PASSWORD_HASH is empty. To turn it on:
#   npm run hash-password -- 'a password with 12 or more characters'
APP_PASSWORD_HASH=
# At least 32 random characters. Needed when sign in is on.
SESSION_SECRET=
